---
import type { ActiveProfileRuntime } from '../../profiles';
import CreativeMachineMonitor from '../global/CreativeMachineMonitor';

interface Props {
  profile: ActiveProfileRuntime;
}

const { profile } = Astro.props;
// The agent route remains a Dessi-only compatibility surface until it is profile-scoped.
const agentHref = profile.handle === 'dessi' ? '/mobile/apps/terminal' : undefined;
const reviewedDate = new Intl.DateTimeFormat('en-GB', {
  day: '2-digit',
  month: 'short',
  year: 'numeric',
}).format(new Date(profile.publication.reviewedAt));

const modules = [
  {
    index: '01',
    label: 'Workbench',
    description: 'Explore the systems and experiments behind the work.',
    href: `/@${profile.handle}/workbench`,
  },
  {
    index: '02',
    label: 'Evidence & Evolution',
    description: 'Reviewed claims, boundaries, questions, and revisions.',
    href: `/@${profile.handle}/evolution`,
  },
  {
    index: '03',
    label: 'Writing',
    description: 'Ideas developed through technical analysis and practice.',
    href: `/@${profile.handle}/writing`,
  },
  {
    index: '04',
    label: 'System Map',
    description: 'Follow the connections across experience, systems, and ideas.',
    href: `/@${profile.handle}/network`,
  },
  {
    index: '05',
    label: 'Resume',
    description: 'Experience, technical focus, and downloadable CV.',
    href: `/@${profile.handle}/resume`,
  },
] as const;
---

<main class="mx-auto max-w-3xl px-5 pb-12 pt-6 text-white sm:px-8">
  <header>
    <div
      class="flex items-center justify-between gap-4 font-mono text-[10px] uppercase tracking-[0.16em]"
    >
      <span class="text-sky-200">Public profile / @{profile.handle}</span>
      <span class="text-white/35">v{profile.projectionVersion}</span>
    </div>
    <h1 class="mt-4 text-[clamp(2rem,8.8vw,3.5rem)] font-semibold leading-none tracking-[-0.045em]">
      {profile.identity.displayName}
    </h1>
    <p class="mt-3 text-[10px] font-medium uppercase tracking-[0.12em] text-white/55">
      {profile.identity.role} · {profile.identity.location}
    </p>
  </header>

  <CreativeMachineMonitor client:load profile={profile} compact agentHref={agentHref} />

  <section class="py-8" aria-labelledby="profile-modules-title">
    <div class="flex items-end justify-between gap-4 border-b border-white/15 pb-3">
      <h2 id="profile-modules-title" class="text-xs font-semibold uppercase tracking-[0.15em]">
        Explore the profile
      </h2>
      <span class="font-mono text-[10px] text-white/45">{agentHref ? '06' : '05'} modules</span>
    </div>
    <ol>
      {
        modules.map((module) => (
          <li class="border-b border-white/10">
            <a class="grid grid-cols-[2rem_1fr_auto] gap-3 py-5" href={module.href}>
              <span class="font-mono text-[10px] text-sky-300">{module.index}</span>
              <span>
                <strong class="block text-sm font-semibold">{module.label}</strong>
                <span class="mt-1 block text-xs leading-5 text-white/50">{module.description}</span>
              </span>
              <span class="text-sky-200" aria-hidden="true">
                →
              </span>
            </a>
          </li>
        ))
      }
    </ol>
    {
      agentHref ? (
        <a
          href={agentHref}
          class="grid grid-cols-[2rem_1fr_auto] gap-3 border-b border-white/10 py-5"
        >
          <span class="font-mono text-[10px] text-sky-300">06</span>
          <span>
            <>
              <strong class="block text-sm font-semibold">Profile Agent</strong>
              <span class="mt-1 block text-xs leading-5 text-white/60">
                Ask questions grounded in the reviewed public record.
              </span>
            </>
          </span>
          <span class="text-sky-200" aria-hidden="true">
            →
          </span>
        </a>
      ) : null
    }
  </section>

  <details class="group mb-8 border-y border-white/15 py-4">
    <summary
      class="flex min-h-11 cursor-pointer list-none items-center justify-between text-sm font-semibold"
    >
      About {profile.identity.possessiveName} practice <span
        class="text-sky-300 group-open:rotate-45"
        aria-hidden="true">+</span
      >
    </summary>
    <p class="mt-3 text-base leading-6 text-white/85">{profile.identity.headline}</p>
    <p class="mt-4 text-sm leading-6 text-white/65">{profile.identity.introduction}</p>
    <p class="mt-4 text-xs leading-5 text-white/55">
      Conceptual lens: <a
        class="text-sky-200 underline underline-offset-4"
        href="https://www.gregegan.net/PERMUTATION/Permutation.html"
        target="_blank"
        rel="noreferrer">Greg Egan’s <cite>Permutation City</cite></a
      >. Pattern is a design metaphor; {profile.identity.preferredName} remains the author and reviewer.
    </p>
  </details>

  <section class="border-t border-white/15 pt-6" aria-labelledby="public-links-title">
    <h2 id="public-links-title" class="text-xs font-semibold uppercase tracking-[0.15em]">
      Public footprint
    </h2>
    <div class="mt-4 flex flex-wrap gap-2">
      {
        profile.links
          .filter((link) => link.surfaces.includes('profile'))
          .map((link) => (
            <a
              href={link.url}
              target={link.url.startsWith('http') ? '_blank' : undefined}
              rel={link.url.startsWith('http') ? 'noopener noreferrer' : undefined}
              class="inline-flex min-h-11 items-center border-b border-white/20 px-1 py-2 text-xs text-white/70"
            >
              {link.label} ↗
            </a>
          ))
      }
    </div>
  </section>

  <footer class="mt-8 border-l border-sky-300/40 pl-3 text-[11px] leading-5 text-white/45">
    <p>Owner-reviewed public projection · reviewed {reviewedDate}</p>
    <p>Private workspace sources are not included.</p>
  </footer>
</main>
