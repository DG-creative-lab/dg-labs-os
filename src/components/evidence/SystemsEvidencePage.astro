---
import {
  activeProfile,
  activeProfileModules,
  type ActiveProfileRuntime,
  type PublicProfileModules,
} from '../../profiles';

type DossierMode = 'general' | 'application';

type DossierCv = {
  pdf: string;
  docx: string;
  markdown: string;
};

type TargetRole = {
  label: string;
  url: string;
};

interface Props {
  profile?: ActiveProfileRuntime;
  modules?: PublicProfileModules;
  mode?: DossierMode;
  cv?: DossierCv;
  targetRole?: TargetRole;
}

const {
  profile = activeProfile,
  modules = activeProfileModules,
  mode = 'general',
  cv = profile.cv.primary.files,
  targetRole,
} = Astro.props as Props;
const isApplication = mode === 'application';
const {
  claims: applicationClaims,
  caseStudies: applicationCaseStudies,
  boundaries: currentBoundaries,
  entries: evolutionEntries,
} = modules.evidenceEvolution;

const confidenceLabel = {
  verified: 'Publicly verifiable',
  'self-reported': 'Employer context',
  inferred: 'Interpretation',
};
---

<main class="application-page">
  <nav
    class="application-nav"
    aria-label={isApplication ? 'Application navigation' : 'Systems and evidence navigation'}
  >
    <a class="brand" href="/desktop">
      <span>DG</span>
      <strong>{profile.identity.displayName}</strong>
    </a>
    <div>
      <a href="#systems">Systems</a>
      <a href="#evolution">Evolution</a>
      <a href="#boundaries">Boundaries</a>
      <a class="nav-action" href={cv.pdf}>CV · PDF</a>
    </div>
  </nav>

  <section class="application-hero" aria-labelledby="application-title">
    <div class="hero-copy">
      <p class="kicker">
        {isApplication ? 'Application' : profile.identity.role} · {profile.identity.location}
      </p>
      <h1 id="application-title">{profile.identity.headline}</h1>
      <p class="hero-intro">{profile.identity.introduction}</p>
      <div class="hero-actions">
        <a class="primary-action" href="#systems">Inspect the evidence</a>
        <a href={`mailto:${profile.contact.publicEmail}`}
          >Contact {profile.identity.preferredName}</a
        >
      </div>
    </div>

    <div class="hero-trace" aria-label="Agent reliability trace">
      <p>Agent reliability trace</p>
      <ol>
        <li><span>01</span><strong>Task</strong><small>What outcome is required?</small></li>
        <li>
          <span>02</span><strong>Context</strong><small>What evidence may the agent use?</small>
        </li>
        <li>
          <span>03</span><strong>Action</strong><small>Which tool, policy and side effect?</small>
        </li>
        <li>
          <span>04</span><strong>Evaluation</strong><small>What failed, changed or improved?</small>
        </li>
        <li>
          <span>05</span><strong>Feedback</strong><small>What should the next run inherit?</small>
        </li>
      </ol>
    </div>

    <div class="hero-role">
      {
        isApplication && targetRole ? (
          <>
            <span>Target role</span>
            <a href={targetRole.url} target="_blank" rel="noreferrer">
              {targetRole.label} ↗
            </a>
          </>
        ) : (
          <>
            <span>Working layer</span>
            <strong>Models → tools → users</strong>
          </>
        )
      }
    </div>
  </section>

  <section class="fit-section reveal" aria-labelledby="fit-title">
    <div class="section-index">00 / {isApplication ? 'POSITION' : 'PRACTICE'}</div>
    <div class="fit-copy">
      <h2 id="fit-title">The recurring problem in my work is control.</h2>
      <p>
        Models can propose. Systems must decide what context is valid, which action is allowed, how
        failure is recorded, and when a person must intervene. I build that surrounding machinery.
      </p>
    </div>
    <dl class="fit-signals">
      <div><dt>Primary language</dt><dd>Python</dd></div>
      <div><dt>Working layer</dt><dd>Models → tools → users</dd></div>
      <div><dt>Evaluation posture</dt><dd>Evidence before confidence</dd></div>
      <div><dt>Current focus</dt><dd>Reliable long-horizon agents</dd></div>
    </dl>
  </section>

  <section id="systems" class="systems-section">
    <header class="section-heading reveal">
      <div class="section-index">01 / SYSTEMS</div>
      <div>
        <h2>Three systems. Three reliability boundaries.</h2>
        <p>Each dossier separates contribution, evaluation, result and limitation.</p>
      </div>
    </header>

    <div class="case-studies">
      {
        applicationCaseStudies.map((study, index) => (
          <article class="case-study reveal">
            <div class="case-number">{String(index + 1).padStart(2, '0')}</div>
            <div class="case-main">
              <p class="case-classification">{study.classification}</p>
              <h3>{study.title}</h3>
              <p class="case-contribution">{study.contribution}</p>
              <ul class="signal-list" aria-label="Role signals">
                {study.roleSignals.map((signal) => (
                  <li>{signal}</li>
                ))}
              </ul>
            </div>
            <div class="case-evidence">
              <dl>
                <div>
                  <>
                    <dt>Failure surface</dt>
                    <dd>{study.problem}</dd>
                  </>
                </div>
                <div>
                  <>
                    <dt>Intervention</dt>
                    <dd>{study.intervention}</dd>
                  </>
                </div>
                <div>
                  <>
                    <dt>Evaluation</dt>
                    <dd>{study.evaluation}</dd>
                  </>
                </div>
                <div>
                  <>
                    <dt>Result</dt>
                    <dd>{study.result}</dd>
                  </>
                </div>
                <div class="limitation">
                  <>
                    <dt>Boundary</dt>
                    <dd>{study.limitation}</dd>
                  </>
                </div>
              </dl>
              {study.evidence.map((link) => (
                <a href={link.url} target="_blank" rel="noreferrer">
                  {link.label} ↗
                </a>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="claims-section reveal" aria-labelledby="claims-title">
    <header>
      <div class="section-index">02 / CLAIMS</div>
      <h2 id="claims-title">Claims carry their own constraints.</h2>
    </header>
    <div class="claims-list">
      {
        applicationClaims.map((claim) => (
          <details>
            <summary>
              <span>{claim.statement}</span>
              <small>{confidenceLabel[claim.confidence]}</small>
            </summary>
            <div class="claim-detail">
              <p>
                <strong>Visibility</strong> {claim.visibility.replaceAll('-', ' ')}
              </p>
              <p>
                <strong>Verified</strong> {claim.lastVerified}
              </p>
              {claim.boundary && (
                <p>
                  <strong>Boundary</strong> {claim.boundary}
                </p>
              )}
              <div>
                {claim.evidence.map((link) => (
                  <a href={link.url} target="_blank" rel="noreferrer">
                    {link.label} ↗
                  </a>
                ))}
              </div>
            </div>
          </details>
        ))
      }
    </div>
  </section>

  <section id="evolution" class="evolution-section">
    <header class="section-heading reveal">
      <div class="section-index">03 / EVOLUTION</div>
      <div>
        <h2>Learning should leave a revision trail.</h2>
        <p>
          The public plane records reviewed changes and open questions. It does not infer a
          personality.
        </p>
      </div>
    </header>
    <ol class="evolution-list">
      {
        evolutionEntries.map((entry) => (
          <li class="reveal">
            <time>{entry.date}</time>
            <span>{entry.kind}</span>
            <div>
              <>
                <h3>{entry.title}</h3>
                <p>{entry.summary}</p>
              </>
            </div>
            <small>{entry.state}</small>
          </li>
        ))
      }
    </ol>
    <a class="inline-link" href={`/@${profile.handle}/evolution`}>
      Open Evidence &amp; Evolution in DG-OS →
    </a>
  </section>

  <section id="boundaries" class="boundaries-section reveal">
    <div class="section-index">04 / BOUNDARIES</div>
    <div>
      <h2>
        {
          isApplication
            ? 'What this application does not claim.'
            : 'What the evidence does not establish.'
        }
      </h2>
      <ol>
        {currentBoundaries.map((boundary) => <li>{boundary}</li>)}
      </ol>
    </div>
  </section>

  <section class="application-close">
    <p class="kicker">{isApplication ? 'Application artifacts' : 'Profile artifacts'}</p>
    <h2>
      {
        isApplication
          ? 'Read the concise version. Inspect the system when detail matters.'
          : 'Read the concise profile. Inspect the systems when detail matters.'
      }
    </h2>
    <div>
      <a class="primary-action" href={cv.pdf}>Download CV · PDF</a>
      <a href={cv.docx}>DOCX</a>
      <a href={cv.markdown}>Markdown</a>
      <a href="/desktop">Explore DG-OS</a>
    </div>
  </section>
</main>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) entry.target.classList.add('is-visible');
      }
    },
    { threshold: 0.12 }
  );
  document.querySelectorAll('.reveal').forEach((element) => observer.observe(element));
</script>

<style>
  :global(html) {
    background: #070b12;
  }
  :global(body) {
    background: #070b12;
    color: #f8fafc;
  }
  .application-page {
    --bg: #070b12;
    --paper: #f8fafc;
    --muted: #94a3b8;
    --line: rgba(148, 163, 184, 0.2);
    --signal: #7dd3fc;
    --signal-surface: rgba(56, 189, 248, 0.1);
    min-height: 100vh;
    background: var(--bg);
    color: var(--paper);
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
  }
  .application-nav {
    position: absolute;
    z-index: 10;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
    padding: 0 clamp(20px, 4vw, 64px);
    border-bottom: 1px solid var(--line);
  }
  .application-nav a {
    color: inherit;
    text-decoration: none;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 13px;
  }
  .brand span {
    display: grid;
    width: 34px;
    height: 34px;
    place-items: center;
    background: var(--paper);
    color: var(--bg);
    font-size: 11px;
    font-weight: 800;
  }
  .application-nav > div {
    display: flex;
    align-items: center;
    gap: 24px;
    font-size: 11px;
  }
  .application-nav .nav-action {
    color: var(--signal);
  }
  .application-hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(320px, 0.8fr);
    min-height: 100svh;
    overflow: hidden;
    padding: 150px clamp(20px, 4vw, 64px) 80px;
  }
  .hero-copy {
    position: relative;
    z-index: 1;
    align-self: center;
    max-width: 780px;
    animation: enter 0.65s ease-out both;
  }
  .kicker,
  .section-index {
    color: var(--signal);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  h1 {
    max-width: 820px;
    margin: 20px 0 24px;
    font-size: clamp(48px, 6.4vw, 96px);
    font-weight: 650;
    line-height: 0.94;
    letter-spacing: -0.05em;
  }
  .hero-intro {
    max-width: 600px;
    color: #cbd5e1;
    font-size: 18px;
    line-height: 1.55;
  }
  .hero-actions,
  .application-close > div {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 22px;
    margin-top: 34px;
  }
  .hero-actions a,
  .application-close a {
    color: var(--paper);
    font-size: 12px;
    text-decoration: none;
  }
  .primary-action {
    display: inline-flex;
    padding: 13px 17px;
    border: 1px solid rgba(125, 211, 252, 0.45);
    background: var(--signal-surface);
    color: #e0f2fe !important;
    font-weight: 700;
  }
  .hero-trace {
    position: relative;
    z-index: 1;
    align-self: center;
    justify-self: end;
    width: min(100%, 430px);
    padding-left: 44px;
  }
  .hero-trace > p {
    margin: 0 0 26px;
    color: var(--muted);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.15em;
  }
  .hero-trace ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .hero-trace li {
    display: grid;
    grid-template-columns: 36px 90px 1fr;
    gap: 10px;
    min-height: 70px;
    align-items: start;
    border-top: 1px solid var(--line);
    padding-top: 12px;
  }
  .hero-trace span {
    color: var(--signal);
    font: 10px/1.8 monospace;
  }
  .hero-trace strong {
    font-size: 12px;
  }
  .hero-trace small {
    color: var(--muted);
    font-size: 13px;
    line-height: 1.4;
  }
  .hero-role {
    position: absolute;
    left: clamp(20px, 4vw, 64px);
    right: clamp(20px, 4vw, 64px);
    bottom: 24px;
    display: flex;
    justify-content: space-between;
    border-top: 1px solid var(--line);
    padding-top: 15px;
    font-size: 10px;
  }
  .hero-role span {
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
  .hero-role a,
  .hero-role strong {
    color: var(--paper);
    font-weight: 600;
    text-decoration: none;
  }
  .fit-section,
  .boundaries-section {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr) minmax(270px, 0.65fr);
    gap: 42px;
    padding: 100px clamp(20px, 4vw, 64px);
    border-top: 1px solid var(--line);
  }
  .fit-copy h2,
  .section-heading h2,
  .claims-section h2,
  .boundaries-section h2,
  .application-close h2 {
    margin: 0;
    font-size: clamp(34px, 4vw, 62px);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.04em;
  }
  .fit-copy p,
  .section-heading p {
    max-width: 700px;
    margin: 24px 0 0;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.6;
  }
  .fit-signals {
    margin: 0;
    border-top: 1px solid var(--line);
  }
  .fit-signals div {
    display: grid;
    grid-template-columns: 1fr 1.35fr;
    gap: 14px;
    padding: 13px 0;
    border-bottom: 1px solid var(--line);
  }
  .fit-signals dt {
    color: var(--muted);
    font-size: 10px;
    text-transform: uppercase;
  }
  .fit-signals dd {
    margin: 0;
    font-size: 12px;
  }
  .systems-section,
  .evolution-section {
    padding: 100px clamp(20px, 4vw, 64px);
    border-top: 1px solid var(--line);
  }
  .section-heading {
    display: grid;
    grid-template-columns: 150px 1fr;
    gap: 42px;
    margin-bottom: 64px;
  }
  .case-study {
    display: grid;
    grid-template-columns: 80px minmax(260px, 0.72fr) minmax(360px, 1.28fr);
    gap: 36px;
    padding: 42px 0;
    border-top: 1px solid var(--line);
  }
  .case-number {
    color: var(--signal);
    font: 12px monospace;
  }
  .case-classification {
    margin: 0 0 13px;
    color: var(--muted);
    font-size: 10px;
    line-height: 1.4;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .case-main h3 {
    margin: 0;
    font-size: 30px;
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.025em;
  }
  .case-contribution {
    margin-top: 17px;
    color: #cbd5e1;
    font-size: 15px;
    line-height: 1.55;
  }
  .signal-list {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
  }
  .signal-list li {
    border-bottom: 1px solid var(--signal);
    padding: 4px 0;
    color: var(--muted);
    font-size: 10px;
  }
  .case-evidence dl {
    margin: 0;
  }
  .case-evidence dl div {
    display: grid;
    grid-template-columns: 112px 1fr;
    gap: 22px;
    padding: 11px 0;
    border-top: 1px solid var(--line);
  }
  .case-evidence dt {
    color: var(--muted);
    font-size: 10px;
    text-transform: uppercase;
  }
  .case-evidence dd {
    margin: 0;
    color: #cbd5e1;
    font-size: 14px;
    line-height: 1.5;
  }
  .case-evidence .limitation dd {
    color: #bae6fd;
  }
  .case-evidence > a,
  .inline-link {
    display: inline-flex;
    margin-top: 18px;
    color: var(--signal);
    font-size: 11px;
    text-decoration: none;
  }
  .claims-section {
    display: grid;
    grid-template-columns: minmax(270px, 0.7fr) 1.3fr;
    gap: 70px;
    padding: 100px clamp(20px, 4vw, 64px);
    background: #0f172a;
    color: var(--paper);
  }
  .claims-section header h2 {
    margin-top: 20px;
  }
  .claims-list {
    border-top: 1px solid var(--line);
  }
  .claims-list details {
    border-bottom: 1px solid var(--line);
  }
  .claims-list summary {
    display: grid;
    grid-template-columns: 1fr 130px;
    gap: 24px;
    padding: 21px 0;
    cursor: pointer;
    list-style: none;
  }
  .claims-list summary::-webkit-details-marker {
    display: none;
  }
  .claims-list summary span {
    font-size: 16px;
    line-height: 1.4;
  }
  .claims-list summary small {
    color: var(--muted);
    font-size: 10px;
    text-align: right;
    text-transform: uppercase;
  }
  .claim-detail {
    padding: 0 150px 22px 0;
    color: #cbd5e1;
    font-size: 12px;
    line-height: 1.5;
  }
  .claim-detail p {
    margin: 6px 0;
  }
  .claim-detail strong {
    display: inline-block;
    min-width: 72px;
    color: var(--paper);
  }
  .claim-detail a {
    display: inline-flex;
    margin: 10px 16px 0 0;
    color: var(--signal);
  }
  .evolution-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .evolution-list li {
    display: grid;
    grid-template-columns: 110px 100px 1fr 90px;
    gap: 26px;
    padding: 25px 0;
    border-top: 1px solid var(--line);
  }
  .evolution-list time,
  .evolution-list > li > span,
  .evolution-list small {
    color: var(--muted);
    font: 10px/1.5 monospace;
    text-transform: uppercase;
  }
  .evolution-list h3 {
    margin: 0;
    font-size: 20px;
    font-weight: 600;
    line-height: 1.2;
  }
  .evolution-list p {
    max-width: 740px;
    margin: 8px 0 0;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.5;
  }
  .boundaries-section {
    grid-template-columns: 150px 1fr;
    background: #0b1220;
  }
  .boundaries-section ol {
    max-width: 900px;
    margin: 38px 0 0;
    padding: 0;
    list-style: none;
    counter-reset: boundary;
  }
  .boundaries-section li {
    counter-increment: boundary;
    display: grid;
    grid-template-columns: 50px 1fr;
    gap: 20px;
    padding: 16px 0;
    border-top: 1px solid var(--line);
    color: #cbd5e1;
    font-size: 16px;
    line-height: 1.5;
  }
  .boundaries-section li::before {
    content: '0' counter(boundary);
    color: var(--signal);
    font: 11px monospace;
  }
  .application-close {
    min-height: 60vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 100px clamp(20px, 8vw, 130px);
    border-top: 1px solid var(--line);
    background: #111827;
    color: var(--paper);
  }
  .application-close .kicker {
    color: var(--signal);
  }
  .application-close h2 {
    max-width: 900px;
    margin-top: 20px;
    font-size: clamp(42px, 6vw, 88px);
  }
  .application-close a {
    color: var(--paper);
  }
  .application-close .primary-action {
    border-color: rgba(125, 211, 252, 0.45);
    background: var(--signal-surface);
    color: #e0f2fe !important;
  }
  .reveal {
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 0.5s ease,
      transform 0.5s ease;
  }
  .reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
  @keyframes enter {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }
  @media (max-width: 900px) {
    .application-nav > div a:not(.nav-action) {
      display: none;
    }
    .application-hero {
      grid-template-columns: 1fr;
      gap: 60px;
      padding-top: 130px;
      padding-bottom: 110px;
    }
    .hero-trace {
      justify-self: start;
      padding-left: 0;
    }
    .fit-section,
    .boundaries-section,
    .claims-section {
      grid-template-columns: 1fr;
      gap: 30px;
    }
    .section-heading {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .case-study {
      grid-template-columns: 50px 1fr;
    }
    .case-evidence {
      grid-column: 2;
    }
    .evolution-list li {
      grid-template-columns: 90px 1fr;
    }
    .evolution-list > li > span {
      text-align: right;
    }
    .evolution-list li div {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 560px) {
    .application-nav {
      padding-inline: 16px;
    }
    .application-hero,
    .fit-section,
    .systems-section,
    .claims-section,
    .evolution-section,
    .boundaries-section {
      padding-left: 20px;
      padding-right: 20px;
    }
    h1 {
      font-size: 48px;
    }
    .hero-intro {
      font-size: 17px;
    }
    .hero-trace li {
      grid-template-columns: 36px 76px 1fr;
    }
    .case-study {
      grid-template-columns: 1fr;
      gap: 18px;
    }
    .case-evidence {
      grid-column: 1;
    }
    .case-evidence dl div {
      grid-template-columns: 1fr;
