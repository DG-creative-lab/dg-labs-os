---
import '../../styles/global.css';
import { AstroSeo } from '@astrolib/seo';
import { activeProfile, type ActiveProfileRuntime } from '../../profiles';
import { theme } from '../../config/site';

interface Props {
  profile?: ActiveProfileRuntime;
  title?: string;
  description?: string;
  canonical?: string;
  robots?: string;
  openGraph?: {
    url?: string;
    title?: string;
    description?: string;
    site_name?: string;
  };
}

const { profile = activeProfile } = Astro.props as Props;

// Build safe defaults for SEO
const siteOrigin = Astro.site ? new URL('/', Astro.site).origin : undefined;
const canonicalUrl = Astro.props.canonical || siteOrigin;
const ogUrl = Astro.props.openGraph?.url || siteOrigin;
---

<!-- Core meta tags -->
<meta charset="UTF-8" />
<meta http-equiv="X-UA-Compatible" content="IE=edge" />
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1" />
<meta name="author" content={profile.identity.displayName} />
{Astro.props.robots ? <meta name="robots" content={Astro.props.robots} /> : null}

<!-- SEO Configuration -->
<AstroSeo
  title={Astro.props.title || profile.seo.title}
  description={Astro.props.description || profile.seo.description}
  canonical={canonicalUrl}
  openGraph={{
    url: ogUrl,
    title: Astro.props.openGraph?.title || profile.seo.title,
    description: Astro.props.openGraph?.description || profile.seo.description,
    site_name: Astro.props.openGraph?.site_name || profile.identity.displayName,
  }}
  twitter={{
    cardType: 'summary_large_image',
  }}
/>

<!-- JSON-LD Schema.org -->
{
  siteOrigin && (
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        url: siteOrigin,
        name: profile.identity.displayName,
        description: profile.seo.description,
      })}
    />
  )
}
{
  siteOrigin && (
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Person',
        name: profile.identity.displayName,
        jobTitle: profile.identity.role,
        url: siteOrigin,
        sameAs: profile.links
          .filter((link) => link.kind === 'profile' || link.kind === 'code')
          .map((link) => link.url),
      })}
    />
  )
}

<!-- Add your favicon files in public/images/ -->
<link rel="apple-touch-icon" sizes="180x180" href="/images/dg-labs.svg" />
<link rel="icon" type="image/svg+xml" href="/images/dg-labs.svg" />
<link rel="icon" type="image/svg+xml" href="/images/dg-labs.svg" />

<!-- Theme colors for browsers -->
<meta name="msapplication-TileColor" content={theme.secondaryColor} />
<meta name="theme-color" content={theme.secondaryColor} />

<!-- Auto-generated sitemap -->
<link rel="sitemap" href="/sitemap-index.xml" />
