---
import IPhoneStatusBar from './iPhoneStatusBar.astro';
import IPhoneHomeIndicator from './iPhoneHomeIndicator.astro';
import IPhoneAppIcon from './iPhoneAppIcon.astro';
import { userConfig } from '../../config/index';
import { activeProfile } from '../../profiles';

const profilePath = `/@${activeProfile.handle}`;
---

<div
  class="min-h-screen flex flex-col justify-between bg-gradient-to-br from-slate-900 via-slate-950 to-indigo-950"
>
  <div>
    <IPhoneStatusBar />
    <div class="mt-8 grid grid-cols-4 gap-5 px-6">
      <IPhoneAppIcon label="Writing" href={`${profilePath}/writing`} className="text-sky-100">
        <div
          class="h-10 w-10 rounded-xl bg-gradient-to-br from-sky-500 to-slate-800 flex items-center justify-center text-white font-semibold"
        >
          W
        </div>
      </IPhoneAppIcon>
      <IPhoneAppIcon label="Projects" href={`${profilePath}/workbench`}>
        <div
          class="h-10 w-10 rounded-xl bg-gradient-to-br from-slate-700 to-slate-900 flex items-center justify-center text-white font-semibold"
        >
          DG
        </div>
      </IPhoneAppIcon>
      <IPhoneAppIcon label="Resume" href="/mobile/apps/resume">
        <div
          class="h-10 w-10 rounded-xl bg-gradient-to-br from-rose-500 to-rose-700 flex items-center justify-center text-white font-semibold"
        >
          CV
        </div>
      </IPhoneAppIcon>
      <IPhoneAppIcon label="System Map" href={`${profilePath}/network`}>
        <div
          class="h-10 w-10 rounded-xl bg-gradient-to-br from-indigo-600 to-fuchsia-700 flex items-center justify-center text-white font-semibold"
        >
          NW
        </div>
      </IPhoneAppIcon>
      <IPhoneAppIcon label="Evidence" href={`${profilePath}/evolution`} className="text-sky-100">
        <div
          class="h-10 w-10 rounded-xl bg-gradient-to-br from-sky-500 to-slate-800 flex items-center justify-center text-white font-semibold"
        >
          ↑
        </div>
      </IPhoneAppIcon>
      <IPhoneAppIcon label="Terminal" href="/mobile/apps/terminal" className="text-emerald-200">
        <div
          class="h-10 w-10 rounded-xl bg-gradient-to-br from-black to-slate-900 border border-emerald-400/40 flex items-center justify-center text-emerald-400 font-semibold"
        >
          $
        </div>
      </IPhoneAppIcon>
      <IPhoneAppIcon label="Contact" href="/#contact">
        <div
          class="h-10 w-10 rounded-xl bg-gradient-to-br from-sky-500 to-blue-700 flex items-center justify-center text-white font-semibold"
        >
          @
        </div>
      </IPhoneAppIcon>
      <IPhoneAppIcon label="LinkedIn" href={userConfig.social.linkedin}>
        <div
          class="h-10 w-10 rounded-xl bg-[#0a66c2] flex items-center justify-center text-white font-semibold"
        >
          in
        </div>
      </IPhoneAppIcon>
      <IPhoneAppIcon label="GitHub" href={userConfig.social.github}>
        <div
          class="h-10 w-10 rounded-xl bg-slate-900 flex items-center justify-center text-white font-semibold"
        >
          GH
        </div>
      </IPhoneAppIcon>
    </div>
  </div>

  <div class="px-6 pb-4">
    <div class="rounded-[28px] bg-white/10 border border-white/10 px-6 py-4 backdrop-blur-md">
      <div class="grid grid-cols-4 gap-4">
        <a href={userConfig.social.linkedin} class="flex flex-col items-center text-white/80">
          <div
            class="h-12 w-12 rounded-2xl bg-[#0a66c2] flex items-center justify-center text-white font-semibold"
          >
            in
          </div>
        </a>
        <a
          href={`mailto:${userConfig.contact.email}`}
          class="flex flex-col items-center text-white/80"
        >
          <div
            class="h-12 w-12 rounded-2xl bg-gradient-to-br from-sky-400 to-blue-600 flex items-center justify-center text-white font-semibold"
          >
            M
          </div>
        </a>
        <a href="/mobile/apps/terminal" class="flex flex-col items-center text-white/80">
          <div
            class="h-12 w-12 rounded-2xl bg-gradient-to-br from-slate-900 to-black flex items-center justify-center text-emerald-400 font-semibold"
          >
            $
          </div>
        </a>
        <a href={`${profilePath}/writing`} class="flex flex-col items-center text-white/80">
          <div
            class="h-12 w-12 rounded-2xl bg-gradient-to-br from-sky-500 to-slate-800 flex items-center justify-center text-white font-semibold"
          >
            W
          </div>
        </a>
      </div>
    </div>
    <IPhoneHomeIndicator />
  </div>
</div>
