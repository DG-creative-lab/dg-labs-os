---
import SystemsEvidencePage from '../../components/evidence/SystemsEvidencePage.astro';
import { openAiCodexApplication } from '../../config/applicationProfile';
import { activeProfile } from '../../profiles';
import { activeProfileModules } from '../../profiles/modules';
import Layout from '../../layouts/Layout.astro';
---

<Layout
  profile={activeProfile}
  title={`${activeProfile.identity.displayName} - ${openAiCodexApplication.role}`}
  description="Evidence-led application for the Applied AI Engineer, Codex Core Agent role."
  canonical={`${activeProfile.contact.website}apply/openai-codex`}
  robots="noindex, nofollow"
>
  <SystemsEvidencePage
    profile={activeProfile}
    modules={activeProfileModules}
    mode="application"
    cv={openAiCodexApplication.applicationCv}
    targetRole={{
      label: openAiCodexApplication.role,
      url: openAiCodexApplication.roleUrl,
    }}
  />
</Layout>
