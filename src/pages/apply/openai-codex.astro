---
import SystemsEvidencePage from '../../components/evidence/SystemsEvidencePage.astro';
import { openAiCodexApplication } from '../../config/applicationProfile';
import { userConfig } from '../../config';
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title={`Dessi Georgieva — ${openAiCodexApplication.role}`}
  description="Evidence-led application for the Applied AI Engineer, Codex Core Agent role."
  canonical={`${userConfig.website}apply/openai-codex`}
  robots="noindex, nofollow"
>
  <SystemsEvidencePage
    mode="application"
    cv={openAiCodexApplication.applicationCv}
    targetRole={{
      label: openAiCodexApplication.role,
      url: openAiCodexApplication.roleUrl,
    }}
  />
</Layout>
