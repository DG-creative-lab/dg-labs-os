---
import DesktopLayout from '../layouts/DesktopLayout.astro';
import HomeDesktop from '../components/global/HomeDesktop';
import { activeProfile } from '../profiles';
---

<DesktopLayout
  profile={activeProfile}
  title={activeProfile.seo.title}
  description={activeProfile.seo.description}
  canonical={activeProfile.contact.website}
  openGraph={{
    url: activeProfile.contact.website,
    title: activeProfile.seo.title,
    description: activeProfile.seo.description,
    site_name: activeProfile.identity.displayName,
  }}
>
  <HomeDesktop client:load profile={activeProfile} />
</DesktopLayout>
