---
import DesktopLayout from '../../layouts/DesktopLayout.astro';
import AgentsTerminal from '../../components/global/AgentsTerminal';
import DraggableAppWindow from '../../components/global/DraggableAppWindow';
import { activeProfile } from '../../profiles';
---

<DesktopLayout
  activeAppId="terminal"
  activeApps={{
    terminal: true,
    notes: false,
    github: false,
    resume: false,
  }}
>
  <main class="relative min-h-[calc(100vh-4rem)] px-6 pt-12 text-white">
    <DraggableAppWindow
      client:load
      title="Profile Agent"
      appId="terminal"
      initialSize={{ width: 1120, height: 720 }}
      initialPosition={{ x: 80, y: 64 }}
      viewportFit={{ widthRatio: 0.84, heightRatio: 0.94 }}
      contentClassName="h-full min-h-0 flex flex-col overflow-hidden text-white"
    >
      <AgentsTerminal client:load profile={activeProfile} />
    </DraggableAppWindow>
  </main>
</DesktopLayout>
