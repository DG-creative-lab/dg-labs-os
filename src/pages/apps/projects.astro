---
import DesktopLayout from '../../layouts/DesktopLayout.astro';
import DraggableAppWindow from '../../components/global/DraggableAppWindow';
import { workbench, workbenchCategories } from '../../config/workbench';
import { activeProfile } from '../../profiles';

const toSectionId = (category: string) =>
  `workbench-${category.toLowerCase().replace(/\s+/g, '-')}`;
---

<DesktopLayout profile={activeProfile} activeAppId="projects">
  <main class="relative min-h-[calc(100vh-4rem)] px-6 pt-12 text-white">
    <DraggableAppWindow
      client:load
      appId="projects"
      title="Workbench"
      closeHref="/desktop"
      initialSize={{ width: 980, height: 680 }}
      initialPosition={{ x: 80, y: 80 }}
    >
      <div class="flex items-start justify-between gap-6">
        <div>
          <h1 class="text-2xl font-semibold">Workbench</h1>
          <p class="mt-2 text-white/70">
            Selected systems {activeProfile.identity.preferredName} can show, explain, and bound with
            evidence.
          </p>
        </div>
        <div class="hidden md:block text-right text-xs text-white/50">
          <p>DG-Labs OS</p>
          <p>Module: Workbench</p>
        </div>
      </div>

      <div class="mt-8 space-y-10">
        {
          workbenchCategories.map((cat) => {
            const items = workbench.filter((x) => x.category === cat);
            if (items.length === 0) return null;
            return (
              <section id={toSectionId(cat)}>
                <div class="flex items-end justify-between gap-6 border-b border-white/15 pb-3">
                  <div>
                    <h2 class="text-sm font-semibold uppercase tracking-[0.16em] text-white/85">
                      {cat}
                    </h2>
                    <p class="mt-1 max-w-2xl text-xs leading-relaxed text-white/50">
                      {cat === 'Selected Systems'
                        ? 'Public code and live systems that can be inspected directly.'
                        : 'Production experience described within employer and client boundaries.'}
                    </p>
                  </div>
                  <span class="text-[10px] uppercase tracking-[0.18em] text-white/35">
                    {String(items.length).padStart(2, '0')}
                  </span>
                </div>
                <div class="divide-y divide-white/10">
                  {items.map((item) => (
                    <article class="grid gap-5 py-6 md:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]">
                      <div>
                        <p class="text-[10px] uppercase tracking-[0.16em] text-white/45">
                          {item.classification}
                        </p>
                        <h3 class="mt-2 text-lg font-semibold">{item.title}</h3>
                        <p class="mt-1 text-sm leading-relaxed text-white/60">{item.subtitle}</p>
                        <p class="mt-4 text-sm leading-relaxed text-white/75">{item.summary}</p>

                        <div class="mt-4 flex flex-wrap gap-x-3 gap-y-1">
                          {item.stack.slice(0, 6).map((tech) => (
                            <span class="text-[11px] text-white/50">{tech}</span>
                          ))}
                        </div>
                      </div>

                      <div class="md:border-l md:border-white/10 md:pl-6">
                        <ul class="space-y-2 text-sm leading-relaxed text-white/70">
                          {item.highlights.slice(0, 4).map((highlight) => (
                            <li class="grid grid-cols-[0.75rem_1fr] gap-2">
                              <span class="text-white/30">—</span>
                              <span>{highlight}</span>
                            </li>
                          ))}
                        </ul>

                        {Object.keys(item.links).length > 0 && (
                          <div class="mt-5 flex flex-wrap gap-4 border-t border-white/10 pt-4">
                            {item.links.repo && (
                              <a
                                class="text-xs font-medium text-white/75 underline decoration-white/25 underline-offset-4 transition hover:text-white hover:decoration-white/70"
                                href={item.links.repo}
                                target="_blank"
                                rel="noopener noreferrer"
                              >
                                Repository ↗
                              </a>
                            )}
                            {item.links.article && (
                              <a
                                class="text-xs font-medium text-white/75 underline decoration-white/25 underline-offset-4 transition hover:text-white hover:decoration-white/70"
                                href={item.links.article}
                                target="_blank"
                                rel="noopener noreferrer"
                              >
                                Related writing ↗
                              </a>
                            )}
                            {item.links.demo && (
                              <a
                                class="text-xs font-medium text-white/75 underline decoration-white/25 underline-offset-4 transition hover:text-white hover:decoration-white/70"
                                href={item.links.demo}
                                target="_blank"
                                rel="noopener noreferrer"
                              >
                                Demo ↗
                              </a>
                            )}
                            {item.links.site && (
                              <a
                                class="text-xs font-medium text-white/75 underline decoration-white/25 underline-offset-4 transition hover:text-white hover:decoration-white/70"
                                href={item.links.site}
                                target="_blank"
                                rel="noopener noreferrer"
                              >
                                Live system ↗
                              </a>
                            )}
                          </div>
                        )}
                      </div>
                    </article>
                  ))}
                </div>
              </section>
            );
          })
        }
      </div>
    </DraggableAppWindow>
  </main>
</DesktopLayout>

<script is:inline>
  const jumpTo = (sectionId) => {
    if (!sectionId) return;
    const el = document.getElementById(sectionId);
    if (!el) return;
    const container = el.closest('.no-scrollbar');
    if (container instanceof HTMLElement) {
      const top = Math.max(0, el.offsetTop - 8);
      container.scrollTo({ top, behavior: 'smooth' });
      return;
    }
    el.scrollIntoView({ behavior: 'smooth', block: 'start' });
  };

  const onWorkbenchMenuAction = (event) => {
    const detail = event.detail;
    if (!detail || !detail.action) return;
    if (detail.action === 'jump_section' && typeof detail.sectionId === 'string') {
      jumpTo(detail.sectionId);
      return;
    }
    if (detail.action === 'scroll_top') {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
  };

  window.addEventListener('dg-workbench-menu-action', onWorkbenchMenuAction);
</script>
