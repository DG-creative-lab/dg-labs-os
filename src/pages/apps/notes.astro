---
import DesktopLayout from '../../layouts/DesktopLayout.astro';
import DraggableAppWindow from '../../components/global/DraggableAppWindow';
import TechnicalWritingApp from '../../components/global/TechnicalWritingApp';
import { activeProfile } from '../../profiles';
import { activeWritingModule } from '../../profiles/writing';
---

<DesktopLayout profile={activeProfile} activeAppId="notes">
  <main class="relative min-h-[calc(100vh-4rem)] px-6 pt-12 text-white">
    <DraggableAppWindow
      client:load
      appId="notes"
      title="Technical Writing"
      closeHref="/desktop"
      initialSize={{ width: 920, height: 680 }}
      initialPosition={{ x: 110, y: 80 }}
    >
      <TechnicalWritingApp client:load profile={activeProfile} writing={activeWritingModule} />
    </DraggableAppWindow>
  </main>
</DesktopLayout>
