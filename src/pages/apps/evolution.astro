---
import DesktopLayout from '../../layouts/DesktopLayout.astro';
import DraggableAppWindow from '../../components/global/DraggableAppWindow';
import EvolutionApp from '../../components/global/EvolutionApp';
---

<DesktopLayout activeAppId="evolution">
  <main class="relative min-h-[calc(100vh-4rem)] px-4 pt-10 text-white sm:px-6 sm:pt-12">
    <DraggableAppWindow
      client:load
      appId="evolution"
      title="Evidence & Evolution"
      closeHref="/desktop"
      initialSize={{ width: 980, height: 700 }}
      initialPosition={{ x: 90, y: 70 }}
    >
      <EvolutionApp client:load />
    </DraggableAppWindow>
  </main>
</DesktopLayout>
