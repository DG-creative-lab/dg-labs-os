---
import DesktopLayout from '../../layouts/DesktopLayout.astro';
import NetworkApp from '../../components/network/NetworkApp';
import { activeNetworkModule } from '../../profiles/network';
import DraggableAppWindow from '../../components/global/DraggableAppWindow';
---

<DesktopLayout activeAppId="network">
  <main class="relative min-h-[calc(100vh-4rem)] px-6 pt-12 text-white">
    <DraggableAppWindow
      client:load
      title="System Map"
      appId="network"
      closeHref="/desktop"
      initialSize={{ width: 1080, height: 700 }}
      initialPosition={{ x: 70, y: 70 }}
    >
      <div class="flex items-start justify-between gap-6">
        <div>
          <p class="text-[10px] font-semibold uppercase tracking-[0.16em] text-sky-200">
            Connections / Curated projection
          </p>
          <h1 class="mt-2 text-2xl font-semibold">System Map</h1>
          <p class="mt-2 text-white/70">
            How career experience, engineering practices, systems, and public evidence connect.
          </p>
        </div>
        <div class="hidden md:block text-right text-xs text-white/50">
          <p>DG-Labs OS</p>
          <p>Module: Connections</p>
        </div>
      </div>

      <NetworkApp
        client:load
        nodes={activeNetworkModule.nodes}
        ideas={activeNetworkModule.relationships}
        paths={activeNetworkModule.paths}
      />
    </DraggableAppWindow>
  </main>
</DesktopLayout>
