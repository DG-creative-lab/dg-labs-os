---
import IPhoneAppLayout from '../../../layouts/iPhoneAppLayout.astro';
import { networkIdeaEdges, networkNodes, networkPaths } from '../../../config/network';
import NetworkApp from '../../../components/network/NetworkApp';
---

<IPhoneAppLayout appLabel="System Map">
  <main class="min-h-screen px-4 pb-24 pt-24 text-white sm:px-6">
    <p class="text-[10px] font-semibold uppercase tracking-[0.16em] text-sky-200">
      Connections / Curated projection
    </p>
    <h1 class="mt-2 text-2xl font-semibold">System Map</h1>
    <p class="mt-2 text-sm leading-6 text-white/65">
      Follow the relationships between experience, engineering practices, systems, and evidence.
    </p>

    <NetworkApp
      client:load
      nodes={networkNodes}
      ideas={networkIdeaEdges}
      paths={networkPaths}
      initialView="INDEX"
      compact={true}
    />
  </main>
</IPhoneAppLayout>
