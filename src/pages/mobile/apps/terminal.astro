---
import IPhoneAppLayout from '../../../layouts/iPhoneAppLayout.astro';
import AgentsTerminal from '../../../components/global/AgentsTerminal';
import { activeProfile } from '../../../profiles';
---

<IPhoneAppLayout profile={activeProfile} appLabel="Profile Agent">
  <main class="min-h-screen px-3 pb-24 pt-20 text-white">
    <div class="mx-auto h-[calc(100dvh-7rem)] min-h-[32rem] max-w-3xl">
      <AgentsTerminal client:load profile={activeProfile} />
    </div>
  </main>
</IPhoneAppLayout>
