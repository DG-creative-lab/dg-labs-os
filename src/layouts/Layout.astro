---
import BaseHead from '../components/global/BaseHead.astro';
import Analytics from '@vercel/analytics/astro';
import { activeProfile, type ActiveProfileRuntime } from '../profiles';

const profile = (Astro.props.profile as ActiveProfileRuntime | undefined) ?? activeProfile;
---

<html lang="en" class="scroll-smooth selection:bg-gray-900 selection:text-white overflow-x-hidden">
  <head>
    <BaseHead
      profile={profile}
      pageKind={Astro.props.pageKind}
      title={Astro.props.title}
      description={Astro.props.description}
      canonical={Astro.props.canonical}
      openGraph={Astro.props.openGraph}
      robots={Astro.props.robots}
    />
  </head>

  <body class="overflow-x-hidden bg-gray-900">
    <slot />
    <Analytics />
  </body>
</html>
