{
  "name": "dg-labs-os",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm resume:check && astro build",
    "build:vercel": "pnpm resume:check && DEPLOY_TARGET=vercel astro build",
    "deploy:preflight": "node scripts/deploy/preflight.mjs",
    "cv:build": "node --import tsx scripts/resume/build-profile-cv.mjs",
    "resume:check": "pnpm cv:build --profile dessi --variant all --check",
    "resume:sync": "pnpm resume:build",
    "resume:build": "pnpm cv:build --profile dessi --variant all",
    "resume:refresh": "pnpm resume:build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "test:unit": "vitest run tests",
    "test:watch": "vitest",
    "test:unit:watch": "vitest tests",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test tests/e2e/smoke.spec.ts",
    "test:architecture": "pnpm architecture:check && vitest run tests/architecture",
    "test:contracts": "vitest run tests/contracts tests/networkModules.test.tsx tests/writingModules.test.tsx tests/resumeModules.test.tsx",
    "test:machines": "vitest run tests/machines",
    "test:interactions": "vitest run tests/interactions",
    "test:harness": "pnpm test:architecture && pnpm test:contracts && pnpm test:machines && pnpm test:interactions",
    "test:network": "vitest run tests/networkGraph.test.ts tests/networkModules.test.tsx tests/networkSearch.test.ts",
    "test:terminal": "vitest run tests/terminalCommands.test.ts",
    "test:terminal:llm": "vitest run tests/terminalLlm.test.ts",
    "test:terminal:settings": "vitest run tests/terminalSettings.test.ts",
    "test:content": "vitest run tests/contentConfig.test.ts tests/contentValidation.test.ts",
    "test:device": "vitest run tests/deviceDetection.test.ts",
    "test:schemas": "vitest run tests/requestSchemas.test.ts",
    "test:api": "vitest run tests/apiResponse.test.ts tests/apiContracts.test.ts tests/apiRoutes.contract.test.ts tests/apiRoutes.success.contract.test.ts",
    "architecture:check": "node scripts/architecture/check-dependencies.mjs",
    "architecture:report": "node scripts/architecture/check-dependencies.mjs --json",
    "lint": "eslint src tests --ext .ts,.tsx,.astro",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,astro,md,json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,astro,md,json,yml,yaml}\"",
    "typecheck": "astro check",
    "check": "pnpm architecture:check && pnpm lint && pnpm format:check && pnpm resume:check && pnpm test && pnpm typecheck"
  },
  "dependencies": {
    "@astrojs/node": "^9.0.0",
    "@astrojs/react": "^4.4.1",
    "@astrojs/sitemap": "^3.6.0",
    "@astrojs/vercel": "^9.0.4",
    "@astrolib/seo": "^1.0.0-beta.8",
    "@openrouter/sdk": "^0.3.0",
    "@supabase/supabase-js": "^2.45.0",
    "@tailwindcss/vite": "^4.0.3",
    "@types/prismjs": "^1.26.5",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vercel/analytics": "^1.6.1",
    "@vercel/firewall": "^1.2.2",
    "@xyflow/react": "^12.11.2",
    "astro": "^5.15.3",
    "fuse.js": "^7.1.0",
    "graphology": "^0.26.0",
    "ogl": "^1.0.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.4.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^15.6.1",
    "tailwindcss": "^4.0.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.58.2",
    "eslint": "^9.35.0",
    "eslint-plugin-astro": "^0.34.0",
    "globals": "^15.10.0",
    "prettier": "^3.3.3",
    "prettier-plugin-astro": "^0.14.0",
    "tsx": "^4.23.5",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.43.0",
    "vitest": "^2.1.1"
  },
  "engines": {
    "node": ">=20 <25",
    "pnpm": ">=10 <11"
  },
  "packageManager": "pnpm@10.15.1+sha512.34e538c329b5553014ca8e8f4535997f96180a1d0f614339357449935350d924e22f8614682191264ec33d1462ac21561aff97f6bb18065351c162c7e8f6de67"
}
